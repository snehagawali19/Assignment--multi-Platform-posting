# Copy this file to .env and fill in your credentials. Never commit .env.
# Empty values are ignored; a platform with missing credentials is reported as "Not configured".

# --- Telegraph (https://telegra.ph/api) -------------------------------------------------------
# Optional: leave empty and an anonymous account is created automatically on first post.
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=Automated Posting

# --- Mastodon (https://docs.joinmastodon.org/methods/statuses/#create) -----------------------
# The server address only (not your handle or profile URL).
# Preferences > Development > New application, scope write:statuses, then copy "Your access token".
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky (https://docs.bsky.app/docs/advanced-guides/posts) ------------------------------
# Settings > Privacy and security > App passwords. Do not use your main account password.
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- GitHub Gist (https://docs.github.com/en/rest/gists/gists#create-a-gist) -----------------
# Classic token with the "gist" scope, or a fine-grained token with Account permissions > Gists: Read and write.
GITHUB_TOKEN=

# --- Pastebin (https://pastebin.com/doc_api) ---------------------------------------------------
# Log in at pastebin.com, then open https://pastebin.com/doc_api and copy Your Unique Developer API Key.
PASTEBIN_API_DEV_KEY=
